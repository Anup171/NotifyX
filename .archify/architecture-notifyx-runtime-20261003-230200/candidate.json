  "cards": [
    {
      "dot": "cyan",
      "title": "Ingestion & Security Gate",
      "items": [
        "API Clients and Dashboard authenticate via Bearer JWT or SHA-256 hashed API Keys",
        "In-memory fixed-window rate limiter enforces 10,000 req/min global and 50 req/min per-user quotas",
        "Layer-1 idempotency uses Redis SET NX EX 86400 to discard duplicate notification requests"
      ]
    },
    {
      "dot": "emerald",
      "title": "Async Dispatch & Delivery",
      "items": [
        "POST /api/notify returns 202 Accepted immediately, queuing delivery via Node.js setImmediate",
        "Delivery pipeline checks user preferences, muted categories, and quiet hours before saving",
        "Connected recipients receive real-time push events broadcast to their private Socket.io room"
      ]
    },
    {
      "dot": "violet",
      "title": "Polling & Webhook Integrations",
      "items": [
        "In-process scheduler polls GitHub public events and Gmail messages on a 5-minute interval",
        "Inbound webhooks for GitHub (HMAC-SHA256 verified) and WhatsApp Cloud API land in the API server",
        "Offline users receive backlog sync upon reconnecting their Socket.io session"
      ]
    },
    {
      "dot": "amber",
      "title": "Runtime Architecture Decision",
      "items": [
        "Hosted on Render as a unified Node.js web service (notifyx-api) on port 3000",
        "BullMQ external worker service was intentionally retired to avoid idle Redis polling costs",
        "Persistent notification history is stored in MongoDB Atlas with 30-day automatic TTL expiry"
      ]
    }
  ]
